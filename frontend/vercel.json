{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://REPLACE-WITH-TUNNEL-URL/api/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://REPLACE-WITH-TUNNEL-URL/media/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

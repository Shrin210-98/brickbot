# Copy to .env and fill in. Everything runs in Docker; host values are only used by docker compose.

# --- Host user ---
# Containers run as this user so bind-mounted files stay owned by you. Set to `id -u` / `id -g`.
# Read by compose for ${HOST_UID}/${HOST_GID}, so raw `docker compose run/exec` works without make.
HOST_UID=1000
HOST_GID=1000

# --- Postgres ---
POSTGRES_USER=brickbot
POSTGRES_PASSWORD=brickbot
POSTGRES_DB=brickbot

# Connection strings as seen from inside the compose network.
DATABASE_URL=postgres://brickbot:brickbot@postgres:5432/brickbot?sslmode=disable
TEST_DATABASE_URL=postgres://brickbot:brickbot@postgres:5432/brickbot_test?sslmode=disable
# Clean scratch database Atlas uses to compute diffs (created by postgres/init).
ATLAS_DEV_URL=postgres://brickbot:brickbot@postgres:5432/atlas_dev?sslmode=disable

# --- API ---
PORT=8080
# At least 32 bytes. Generate with: openssl rand -base64 48
SESSION_SECRET=
# Admin login. Used only by `make seed`, and only when the profile row does not exist yet;
# changing them afterwards has no effect. Password: at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Sets the Secure flag on the admin session cookie. false for local dev over http.
# true in production behind HTTPS (Vercel + Cloudflare Tunnel). See docs/deploy.md.
COOKIE_SECURE=false
# Exact Origin the frontend sends for non-GET requests; any other Origin gets 403.
# One origin only: with https:// and no trailing slash.
# Local dev: http://localhost:5173. Vercel prod: https://your-app.vercel.app
# (while it holds the Vercel URL, POSTs from local dev are rejected).
# No CORS setting exists or is needed: Vercel proxies /api, so it's same-origin.
APP_ORIGIN=http://localhost:5173
# true when the backend runs behind a reverse proxy or tunnel (Cloudflare Tunnel,
# nginx, Vercel rewrite): the client IP is then the last X-Forwarded-For entry.
# false (local dev) uses the peer address; behind a tunnel that is the tunnel's
# IP for every visitor, so per-IP rate limits (e.g. login) are shared by all.
TRUST_PROXY=false
UPLOAD_DIR=/data/uploads

# --- Chatbot ---
# Leave empty for demo mode: the chatbot works, but its replies are scripted
# (tools, listings and leads are real). Set a key for live answers.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
